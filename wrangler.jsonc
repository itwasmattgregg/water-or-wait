{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "water-or-wait",
  "compatibility_date": "2026-10-16",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
